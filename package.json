{
  "name": "repo-knowledge-graph",
  "version": "0.3.0",
  "description": "Local repository knowledge graph, context search and pluggable routing",
  "type": "module",
  "bin": {
    "repo-graph": "./bin/repo-graph.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./adapters": "./src/adapters.js",
    "./benchmark": "./src/benchmark.js"
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check src/index.js && node --check bin/repo-graph.js && node --check src/adapters.js && node --check src/benchmark.js",
    "prepublishOnly": "npm test && npm run check"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "src",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naubadnithin7/repo-knowledge-graph.git"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  }
}
